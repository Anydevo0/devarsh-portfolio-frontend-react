# Committed on purpose, like .env.production (VITE_API_BASE_URL isn't a secret) —
# Vitest runs in "test" mode by default, which doesn't read .env.production, so
# without this file `src/lib/env.ts` throws "Missing required env var" on every test
# that imports it, in CI and on any machine without a local .env.
VITE_API_BASE_URL=http://localhost:8000/api/v1
